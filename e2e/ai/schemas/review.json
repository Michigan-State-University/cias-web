{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "corrections", "coverage_gaps", "notes"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approved", "needs_revision"]
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "problem", "fix", "source"],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "suggested_scenario"],
        "properties": {
          "description": {
            "type": "string"
          },
          "suggested_scenario": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
