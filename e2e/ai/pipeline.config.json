{
  "repo": "Michigan-State-University/cias-web",
  "baseBranch": "dev",
  "branchPrefix": "e2e-ai/",
  "e2e": {
    "dir": "e2e",
    "pagesDir": "e2e/pages",
    "browserProject": "webkit",
    "authProject": "setup",
    "seedProject": "ai",
    "readOnly": ["e2e/fixtures", "e2e/auth.setup.ts", "e2e/.auth"],
    "selectorAttribute": "data-cy"
  },
  "scenariosDir": "e2e/scenarios",
  "knowledgeDirs": ["docs/knowledge-pills", "../.claude/knowledge-pills"],
  "pairedRepo": "Michigan-State-University/cias-api",
  "pairedRepoDirs": ["../cias-api", ".paired/cias-api"],
  "pairedBehaviour": {
    "behaviourPathPattern": "^(app|lib|config|db/migrate)/",
    "nonBehaviourPathPatterns": ["^spec/", "^test/", "^config/locales/"]
  },
  "ticketPattern": "cias\\d*-(\\d{3,5})",
  "skip": {
    "authors": ["dependabot[bot]"],
    "headBranchPatterns": [
      "^e2e-ai/",
      "^master$",
      "^test$",
      "^dev_to_test_",
      "^test_to_master_"
    ],
    "labels": ["skip-e2e-gen"],
    "behaviourPathPattern": "^app/",
    "nonBehaviourPathPatterns": [
      "/tests?/",
      "\\.test\\.[jt]sx?$",
      "__snapshots__",
      "^app/translations/"
    ]
  },
  "maxBudgetUsdPerCommand": 20,
  "server": {
    "port": 4200,
    "startTimeoutMinutes": 6
  },
  "staleDraftDays": 14,
  "smallChange": {
    "maxFiles": 3,
    "maxChangedLines": 60,
    "stages": {
      "plan": {
        "effort": "medium",
        "maxBudgetUsd": 3
      },
      "review": {
        "effort": "low",
        "maxBudgetUsd": 0.75
      }
    }
  },
  "stages": {
    "triage": {
      "enabled": true,
      "model": "claude-haiku-4-5",
      "maxBudgetUsd": 0.5,
      "timeoutMinutes": 5
    },
    "plan": {
      "model": "claude-opus-5",
      "maxBudgetUsd": 8,
      "timeoutMinutes": 30
    },
    "review": {
      "model": "claude-sonnet-5",
      "maxBudgetUsd": 2,
      "timeoutMinutes": 20,
      "maxRevisions": 2,
      "effort": "medium"
    },
    "codegen": {
      "model": "claude-opus-5",
      "maxBudgetUsd": 10,
      "timeoutMinutes": 45
    },
    "heal": {
      "model": "claude-sonnet-5",
      "escalationModel": "claude-opus-5",
      "maxBudgetUsd": 3,
      "timeoutMinutes": 20,
      "maxRounds": 2
    }
  }
}
